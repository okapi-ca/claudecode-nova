{
  "identifier": "ca.okapi.claudecode-nova",
  "name": "Claude Code Bridge",
  "organization": "okapi-ca",
  "description": "Integrates Claude Code CLI with Nova via the WebSocket MCP protocol, providing context sharing, diff viewing, and selection tracking.",
  "version": "0.5.0",
  "categories": ["commands", "sidebars"],
  "license": "MIT",
  "repository": "https://github.com/okapi-ca/claudecode-nova",
  "bugs": "https://github.com/okapi-ca/claudecode-nova/issues",
  "min_runtime": "10.0",

  "main": "main.js",

  "activationEvents": ["*"],

  "entitlements": {
    "process": true,
    "filesystem": "readwrite",
    "requests": true,
    "clipboard": true
  },


  "commands": {
    "editor": [
      {
        "title": "Send Selection to Claude",
        "command": "claudecode.sendSelection",
        "when": "editorHasSelection",
        "shortcut": "cmd-ctrl-l"
      }
    ],
    "extensions": [
      {
        "title": "Start Claude Code Bridge",
        "command": "claudecode.start"
      },
      {
        "title": "Stop Claude Code Bridge",
        "command": "claudecode.stop"
      },
      {
        "title": "Restart Claude Code Bridge",
        "command": "claudecode.restart"
      },
      {
        "title": "Add Current File to Claude",
        "command": "claudecode.addFile",
        "shortcut": "cmd-ctrl-a"
      },
      {
        "title": "Show Claude Code Status",
        "command": "claudecode.status"
      },
      {
        "title": "Launch Claude Code (with IDE integration)",
        "command": "claudecode.launchClaude"
      }
    ]
  },

  "sidebars": [
    {
      "id": "claudecode.sidebar",
      "name": "Claude Code",
      "smallImage": "claude-icon-small",
      "largeImage": "claude-icon-large",
      "sections": [
        {
          "id": "claudecode.sidebar.status",
          "name": "Status",
          "placeholderText": "Claude Code is not connected.",
          "headerCommands": [
            {
              "title": "Start",
              "image": "__builtin.play",
              "command": "claudecode.start",
              "tooltip": "Start Claude Code Bridge"
            },
            {
              "title": "Stop",
              "image": "__builtin.stop",
              "command": "claudecode.stop",
              "tooltip": "Stop Claude Code Bridge"
            }
          ]
        },
        {
          "id": "claudecode.sidebar.diffs",
          "name": "Pending Diffs",
          "placeholderText": "No diffs awaiting review.",
          "headerCommands": [
            {
              "title": "Refresh",
              "image": "__builtin.refresh",
              "command": "claudecode.sidebarRefresh",
              "tooltip": "Refresh sidebar"
            }
          ]
        },
        {
          "id": "claudecode.sidebar.activity",
          "name": "Activity",
          "placeholderText": "No activity yet.",
          "headerCommands": [
            {
              "title": "Refresh",
              "image": "__builtin.refresh",
              "command": "claudecode.sidebarRefresh",
              "tooltip": "Refresh sidebar"
            },
            {
              "title": "Clear",
              "image": "__builtin.remove",
              "command": "claudecode.activityClear",
              "tooltip": "Clear activity log"
            }
          ]
        }
      ]
    }
  ],

  "config": [
    {
      "key": "claudecode.portMin",
      "title": "Port Range (Min)",
      "type": "number",
      "default": 10000
    },
    {
      "key": "claudecode.portMax",
      "title": "Port Range (Max)",
      "type": "number",
      "default": 65535
    },
    {
      "key": "claudecode.autoStart",
      "title": "Auto-start on activation",
      "type": "boolean",
      "default": true
    },
    {
      "key": "claudecode.trackSelection",
      "title": "Track editor selection",
      "type": "boolean",
      "default": true
    },
    {
      "key": "claudecode.nodePath",
      "title": "Path to Node.js",
      "type": "string",
      "default": "node",
      "description": "Path to the node executable used for the WebSocket server helper."
    },
    {
      "key": "claudecode.diffTimeoutMinutes",
      "title": "Auto-reject pending diffs after (minutes)",
      "type": "number",
      "default": 30,
      "description": "If a diff stays in the Pending Diffs queue longer than this, the bridge auto-rejects it so Claude isn't stuck waiting on a dead requestId. Set to 0 to disable."
    },
    {
      "key": "claudecode.terminalApp",
      "title": "Terminal Application",
      "type": "enum",
      "values": [
        ["auto", "Auto-detect (iTerm if installed, otherwise Terminal)"],
        ["iTerm", "iTerm2"],
        ["Terminal", "Terminal.app"],
        ["clipboard", "Just copy the command to clipboard"]
      ],
      "default": "auto",
      "description": "Where the \"Launch Claude Code\" command opens the CLI. Other terminals (Warp, Ghostty, Hyper) fall back to clipboard — choose \"clipboard\" explicitly to keep the v0.1.x behaviour."
    }
  ],

  "configWorkspace": [
    {
      "key": "claudecode.claudeCommand",
      "title": "Claude CLI command",
      "type": "string",
      "default": "claude",
      "description": "Command to launch Claude Code CLI."
    },
    {
      "key": "claudecode.claudeArgs",
      "title": "Extra Claude CLI arguments",
      "type": "string",
      "default": "",
      "description": "Arguments appended after the Claude command on launch (e.g. \"--continue\", \"--model claude-opus-4-7\", \"--dangerously-skip-permissions\"). Leave blank for default behaviour."
    }
  ]
}
