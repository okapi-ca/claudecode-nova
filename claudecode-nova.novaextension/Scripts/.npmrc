# Nova's `extension validate` rejects symlinks inside the bundle
# (e.g. node_modules/.bin/node-which → ../which/bin/node-which) and
# fails with "The package does not have a valid extension.json file".
# We never use the .bin CLI wrappers at runtime — only the resolved
# require paths — so disabling them entirely is safer than the
# postinstall rm -rf race we used before.
bin-links=false
